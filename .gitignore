# ---- Root .gitignore for the School Grading App monorepo ----
# (mobile/ also has its own Flutter .gitignore)


# OS / editor files
.DS_Store
Thumbs.db
*.swp
.vscode/

# ---- .NET API (api/) ----
**/bin/
**/obj/
**/.vs/
*.user
*.suo
# Never commit real secrets (DB passwords, JWT keys)
**/appsettings.*.local.json
*.local.json
*.env

# ---- Flutter (mobile/) ----
mobile/build/
mobile/.dart_tool/
mobile/android/local.properties
mobile/android/.gradle/

# ---- Office temp files (docs/) ----
~$*

# ---- Python tools (screenshots / documents) ----
tools/.venv/
__pycache__/

# ---- local logs ----
*.log

# ---- portable Node.js + npm packages (Postman/Newman runner) ----
tools/node/
tools/node-download/
node_modules/

# ---- portable Azure CLI + browser profile used for Azure Portal screenshots ----
tools/azure-cli/
tools/azure-cli-download/
tools/.azure_browser_profile/
